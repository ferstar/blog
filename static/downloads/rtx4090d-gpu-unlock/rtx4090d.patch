index 919ad91..8d8ce77 100644
--- a/kernel/gpu_unlock/main.c
+++ b/kernel/gpu_unlock/main.c
@@ -16,6 +16,10 @@ static bool ad103_experimental;
 module_param(ad103_experimental, bool, 0444);
