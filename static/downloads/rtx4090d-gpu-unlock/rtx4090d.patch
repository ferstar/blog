 			return true;
@@ -126,6 +132,11 @@ static int __init gpu_unlock_init(void)
 	if (!all)
 		report_unmatched();
 	while ((pdev = next_supported(pdev))) {
+		if (pdev->device == GU_AD102_RTX_4090_D &&
+		    (all || strcasecmp(targets, pci_name(pdev)))) {
+			pci_err(pdev, "gpu_unlock: experimental RTX 4090 D requires a single exact PCI target\n");
+			continue;
+		}
 		if (pdev->device == GU_AD103_RTX_4070_TI_SUPER &&
 		    (all || strcasecmp(targets, pci_name(pdev)))) {
 			pci_err(pdev, "gpu_unlock: experimental AD103 requires a single exact PCI target\n");
diff --git a/kernel/gpu_unlock/unlock_610.c b/kernel/gpu_unlock/unlock_610.c
index 5c668c4..8f27f75 100644
--- a/kernel/gpu_unlock/unlock_610.c
+++ b/kernel/gpu_unlock/unlock_610.c
@@ -73,6 +73,7 @@ static const struct gpu_unlock_assets *unlock_assets(const struct pci_dev *pdev)
 	};
 
 	return (pdev->device == GU_AD102_RTX_4090 ||
+		pdev->device == GU_AD102_RTX_4090_D ||
 		pdev->device == GU_AD103_RTX_4070_TI_SUPER) ? &ad102 : &ga102;
 }
 
@@ -317,6 +318,7 @@ static bool is_ad102(const struct unlock_transaction_work *work)
 	/* AD103 uses the same pinned AD102-family Booter archive. Hardware
 	 * behavior on 0x2705 still requires an exact-card canary. */
 	return work->pdev->device == GU_AD102_RTX_4090 ||
+	       work->pdev->device == GU_AD102_RTX_4090_D ||
 	       work->pdev->device == GU_AD103_RTX_4070_TI_SUPER;
 }
 
